# Google Gemini API Key
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# Text model used for analysis/chat/find-places flows
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Quotas
IDEA_LIMIT_PER_MONTH=5
IMAGE_LIMIT_PER_IDEA_PER_MONTH=3

# Comma-separated emails that bypass quota limits (still tracked)
ADMIN_BYPASS_EMAILS=zorovt18@gmail.com

# Replit App Storage bucket ID (recommended explicit config)
REPLIT_OBJECT_STORAGE_BUCKET_ID=your_bucket_id_here
