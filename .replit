modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"

[nix]
channel = "stable-25_05"

[env]
GEMINI_API_KEY = "your_api_key_here"

[agent]
expertMode = true

[[ports]]
localPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"

[objectStorage]
defaultBucketID = "replit-objstore-0c0abee1-de7c-4636-8c9d-f498e95f453a"

[userenv]

[userenv.shared]
REPLIT_OBJECT_STORAGE_BUCKET_ID = "replit-objstore-0c0abee1-de7c-4636-8c9d-f498e95f453a"
